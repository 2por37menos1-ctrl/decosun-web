{
  "routes": [
    {
      "src": "/cambio-tela-toldos-proyectantes/?",
      "dest": "/cambio-tela-toldos-proyectantes/index.html"
    },
    {
      "src": "/cortinas-plisadas-honeycomb/?",
      "dest": "/cortinas-plisadas-honeycomb/index.html"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/guia-de-telas/?",
      "dest": "/guia-de-telas/index.html"
    },
    {
      "src": "/telas/blackout/?",
      "dest": "/telas/blackout/index.html"
    },
    {
      "src": "/telas/sunscreen/?",
      "dest": "/telas/sunscreen/index.html"
    },
    {
      "src": "/telas/translucida/?",
      "dest": "/telas/translucida/index.html"
    },
    {
      "src": "/motorizacion/?",
      "dest": "/motorizacion/index.html"
    },
    {
      "src": "/soluciones/?",
      "dest": "/soluciones/index.html"
    },
    {
      "src": "/mantencion/?",
      "dest": "/mantencion/index.html"
    },
    {
      "src": "/proyectos/?",
      "dest": "/proyectos/index.html"
    },
    {
      "src": "/nosotros/?",
      "dest": "/nosotros/index.html"
    },
    {
      "src": "/garantia/?",
      "dest": "/garantia/index.html"
    },
    {
      "src": "/(?:cotizar|agenda|login)/?",
      "dest": "/app.html",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "src": "/(?:panel|estado)(?:/.*)?",
      "dest": "/app.html",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      }
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
